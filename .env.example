# ============================================
# TOC VIET LAB - Environment Variables
# Copy file này thành .env.local và điền giá trị thật
# ============================================

# --- Cloudflare R2 (Image Storage) ---
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=toc-viet-lab
CLOUDFLARE_R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# Public URL cho ảnh (CDN hoặc dev URL)
NEXT_PUBLIC_ASSET_BASE_URL=https://your-r2-public-url.r2.dev
# Khi CDN active, đổi thành domain CDN của bạn

# --- Cloudflare D1 (Database) ---
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id
CLOUDFLARE_D1_TOKEN=your_cloudflare_api_token

# --- NextAuth.js ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# --- Google OAuth (tuỳ chọn) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
